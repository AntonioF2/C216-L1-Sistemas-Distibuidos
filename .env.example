# Porta da API no computador; a porta interna do container e 8000.
MESA_API_PORTA=8000
# Porta local da interface; CORS acompanha esta porta por padrao.
MESA_FRONTEND_PORTA=5173
# Opcionais para enderecos personalizados, sem segredos.
MESA_ORIGENS_FRONTEND=
VITE_MESA_API_URL=

# Configuracao do PostgreSQL para desenvolvimento local.
MESA_DB_NOME=mesa_rodada
MESA_DB_USUARIO=operador_mesa
# Preencha somente no .env local. Nao versione uma senha real.
MESA_DB_SENHA=
