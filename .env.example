# Valores apenas para desenvolvimento local. O Compose usa db como hostname.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=c216
# Para ferramentas locais, exporte estas variáveis no terminal (ver README).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/c216
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/c216_test
